 // NOLINTEND(clang-analyzer-core.StackAddressEscape)
+
+// Engine-level regression using the real embedder presentation dispatch. The
+// existing proc-table seam supplies a controlled engine and synchronization.
+#include <atomic>
+#include <thread>
+
+namespace {
+struct PresentationReferenceState {
+  GMutex mutex;
+  GCond condition;
+  gboolean entered = FALSE;
+  gboolean released = FALSE;
+  std::atomic<bool> finalized{false};
+  std::atomic<bool> finalized_on_gtk{false};
+  GThread* gtk = g_thread_self();
+
+  PresentationReferenceState() {
+    g_mutex_init(&mutex);
+    g_cond_init(&condition);
+  }
+  ~PresentationReferenceState() {
+    g_cond_clear(&condition);
+    g_mutex_clear(&mutex);
+  }
+};
+}  // namespace
+
+TEST_F(FlEngineTest, PresentationLastReferenceReturnsToGtk) {
+  FlutterCompositor compositor = {};
+  auto* api = fl_engine_get_embedder_api(engine);
+  auto initialize = api->Initialize;
+  api->Initialize = MOCK_ENGINE_PROC(
+      Initialize,
+      ([&](size_t version, const FlutterRendererConfig* config,
+           const FlutterProjectArgs* args, void* user_data, auto* engine_out) {
+        compositor = *args->compositor;
+        return initialize(version, config, args, user_data, engine_out);
+      }));
+  StartEngine();
+  ASSERT_NE(compositor.present_view_callback, nullptr);
+
+  PresentationReferenceState state;
+  auto* renderable = fl_mock_renderable_new();
+  g_object_set_data(G_OBJECT(renderable), "presentation-reference-state", &state);
+  auto* iface = FL_RENDERABLE_GET_IFACE(renderable);
+  auto original_present = iface->present_layers;
+  iface->present_layers = [](FlRenderable* renderable, const FlutterLayer**, size_t) {
+    auto* state = static_cast<PresentationReferenceState*>(
+        g_object_get_data(G_OBJECT(renderable), "presentation-reference-state"));
+    g_mutex_lock(&state->mutex);
+    state->entered = TRUE;
+    g_cond_signal(&state->condition);
+    while (!state->released) {
+      g_cond_wait(&state->condition, &state->mutex);
+    }
+    g_mutex_unlock(&state->mutex);
+  };
+  g_object_weak_ref(
+      G_OBJECT(renderable),
+      [](gpointer data, GObject*) {
+        auto* state = static_cast<PresentationReferenceState*>(data);
+        state->finalized_on_gtk = g_thread_self() == state->gtk;
+        state->finalized = true;
+      },
+      &state);
+  fl_engine_set_implicit_view(engine, FL_RENDERABLE(renderable));
+
+  FlutterPresentViewInfo info = {};
+  info.struct_size = sizeof(info);
+  info.view_id = 0;
+  info.user_data = engine;
+  std::thread raster([&] { compositor.present_view_callback(&info); });
+  g_mutex_lock(&state.mutex);
+  while (!state.entered) {
+    g_cond_wait(&state.condition, &state.mutex);
+  }
+  // The raster callback is now the sole reference owner. No sleep or GTK
+  // scheduling assumption can hide a final release on the wrong thread.
+  g_object_unref(renderable);
+  state.released = TRUE;
+  g_cond_signal(&state.condition);
+  g_mutex_unlock(&state.mutex);
+  raster.join();
+  EXPECT_FALSE(state.finalized);
+  while (g_main_context_iteration(nullptr, FALSE)) {}
+  EXPECT_TRUE(state.finalized);
+  EXPECT_TRUE(state.finalized_on_gtk);
+  iface->present_layers = original_present;
+}
+
+TEST_F(FlEngineTest, CompletedPresentationReferencesAreBoundedAndDrained) {
+  FlutterCompositor compositor = {};
+  auto* api = fl_engine_get_embedder_api(engine);
+  auto initialize = api->Initialize;
+  api->Initialize = MOCK_ENGINE_PROC(
+      Initialize,
+      ([&](size_t version, const FlutterRendererConfig* config,
+           const FlutterProjectArgs* args, void* user_data, auto* engine_out) {
+        compositor = *args->compositor;
+        return initialize(version, config, args, user_data, engine_out);
+      }));
+  StartEngine();
+  auto* renderable = fl_mock_renderable_new();
+  PresentationReferenceState state;
+  g_object_weak_ref(
+      G_OBJECT(renderable),
+      [](gpointer data, GObject*) {
+        auto* state = static_cast<PresentationReferenceState*>(data);
+        state->finalized_on_gtk = g_thread_self() == state->gtk;
+        state->finalized = true;
+      },
+      &state);
+  fl_engine_set_implicit_view(engine, FL_RENDERABLE(renderable));
+  FlutterPresentViewInfo info = {};
+  info.struct_size = sizeof(info);
+  info.user_data = engine;
+  std::thread raster([&] {
+    for (int frame = 0; frame < 10000; ++frame) {
+      EXPECT_TRUE(compositor.present_view_callback(&info));
+    }
+  });
+  raster.join();
+  // One application reference and one coalesced GTK handoff, regardless of
+  // the frame count. No main-loop dispatch is needed to bound the queue.
+  EXPECT_EQ(G_OBJECT(renderable)->ref_count, 2u);
+  g_object_unref(renderable);
+  EXPECT_FALSE(state.finalized);
+  g_object_run_dispose(G_OBJECT(engine));
+  EXPECT_TRUE(state.finalized);
+  EXPECT_TRUE(state.finalized_on_gtk);
+  // A disposed engine rejects later admission and can be disposed again.
+  EXPECT_TRUE(compositor.present_view_callback(&info));
+  g_object_run_dispose(G_OBJECT(engine));
+}
+
+TEST_F(FlEngineTest, CompositorRetirementRunsOnRenderThreadAndRejectsNewFrames) {
+  StartEngine();
+  g_autoptr(FlCompositorSoftware) compositor =
+      fl_compositor_software_new(fl_engine_get_task_runner(engine));
+  GThread* gtk = g_thread_self();
+  GThread* cleanup = nullptr;
+  std::thread raster;
+  fl_engine_get_embedder_api(engine)->PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask, ([&](auto, auto callback, void* data) {
+        raster = std::thread([&cleanup, callback, data] {
+          cleanup = g_thread_self();
+          callback(data);
+        });
+        return kSuccess;
+      }));
+  fl_engine_shutdown_compositor(engine, FL_COMPOSITOR(compositor));
+  raster.join();
+  EXPECT_NE(cleanup, gtk);
+  // A real software compositor must never recreate its surface after its
+  // retirement fence has completed. This does not change the runtime backend.
+  uint32_t pixels[4] = {};
+  FlutterBackingStore store = {};
+  store.type = kFlutterBackingStoreTypeSoftware;
+  store.software.allocation = pixels;
+  store.software.row_bytes = 2 * sizeof(uint32_t);
+  store.software.height = 2;
+  FlutterLayer layer = {};
+  layer.type = kFlutterLayerContentTypeBackingStore;
+  layer.backing_store = &store;
+  layer.size.width = 2;
+  layer.size.height = 2;
+  const FlutterLayer* layers[] = {&layer};
+  EXPECT_TRUE(fl_compositor_present_layers(FL_COMPOSITOR(compositor), layers, 1));
+  size_t width, height;
+  fl_compositor_get_frame_size(FL_COMPOSITOR(compositor), &width, &height);
+  EXPECT_EQ(width, 0u);
+  EXPECT_EQ(height, 0u);
+  fl_compositor_shutdown(FL_COMPOSITOR(compositor));
+}
+
+TEST_F(FlEngineTest, FailedRetirementPostJoinsEngineBeforeResourceRelease) {
+  StartEngine();
+  g_autoptr(FlCompositorSoftware) compositor =
+      fl_compositor_software_new(fl_engine_get_task_runner(engine));
+  auto* api = fl_engine_get_embedder_api(engine);
+  auto shutdown = api->Shutdown;
+  int shutdown_count = 0;
+  api->Shutdown = MOCK_ENGINE_PROC(Shutdown, ([&](auto handle) {
+    ++shutdown_count;
+    return shutdown(handle);
+  }));
+  api->PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto, auto, void*) { return kInternalInconsistency; }));
+  fl_engine_shutdown_compositor(engine, FL_COMPOSITOR(compositor));
+  EXPECT_EQ(shutdown_count, 1);
+  g_object_run_dispose(G_OBJECT(engine));
+  g_object_run_dispose(G_OBJECT(engine));
+  EXPECT_EQ(shutdown_count, 1);
+}
