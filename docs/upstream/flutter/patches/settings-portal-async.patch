+static gint find_setting(const gchar* ns, const gchar* key) {
+  for (guint i = 0; i < G_N_ELEMENTS(kAllSettings); ++i) {
+    if (g_str_equal(ns, kAllSettings[i].ns) &&
+        g_str_equal(key, kAllSettings[i].key)) {
+      return static_cast<gint>(i);
+    }
+  }
+  return -1;
