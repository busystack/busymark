+// only these weak contexts until its cancellable operation completes.
+struct PortalCallback {
+  GWeakRef portal;
+  guint64 generation;
+  guint index;
+  guint64 revision;
+  PortalCallback(FlSettingsPortal* self, guint slot = 0)
+      : generation(self->generation),
+        index(slot),
+        revision(self->requests[slot].revision) {
+    g_weak_ref_init(&portal, self);
