+static void proxy_cb(GObject*, GAsyncResult* result, gpointer user_data) {
+  std::unique_ptr<PortalCallback> callback(
+      static_cast<PortalCallback*>(user_data));
+  g_autoptr(GError) error = nullptr;
+  g_autoptr(GDBusProxy) proxy = g_dbus_proxy_new_finish(result, &error);
+  g_autoptr(FlSettingsPortal) self =
+      FL_SETTINGS_PORTAL(g_weak_ref_get(&callback->portal));
+  if (self == nullptr || self->retired) {
+    return;
+  }
+  if (g_cancellable_is_cancelled(self->cancellable)) {
+    complete_initialization(self);
+    return;
+  }
+  if (proxy == nullptr) {
+    if (g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+      complete_initialization(self);
+    } else {
+      use_local_settings(self, error);
+    }
+    return;
+  }
+  self->dbus_proxy = G_DBUS_PROXY(g_steal_pointer(&proxy));
+  self->owner = g_dbus_proxy_get_name_owner(self->dbus_proxy);
+  self->had_owner = self->owner != nullptr;
+  // Subscribe before issuing any reads. A key revision prevents an older
+  // initial response from replacing a later SettingChanged notification.
+  g_signal_connect_object(self->dbus_proxy, "g-signal",
+                          G_CALLBACK(settings_portal_changed_cb), self,
+                          static_cast<GConnectFlags>(0));
+  g_signal_connect_object(self->dbus_proxy, "notify::g-name-owner",
+                          G_CALLBACK(owner_changed_cb), self,
+                          static_cast<GConnectFlags>(0));
+  read_settings(self);
+}
