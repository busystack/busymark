+static gboolean valid_value(guint index, GVariant* value) {
+  if (!g_variant_is_of_type(value, kAllSettings[index].type)) {
+    return FALSE;
+  }
+  if (g_variant_type_equal(kAllSettings[index].type, G_VARIANT_TYPE_DOUBLE)) {
+    const gdouble scale = g_variant_get_double(value);
+    return std::isfinite(scale) && scale > 0;
+  }
+  return TRUE;
+}
