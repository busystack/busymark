+static void disconnect_initial_cancellable(FlSettingsPortal* self) {
+  if (self->external_cancel_id != 0) {
+    g_cancellable_disconnect(self->external_cancellable,
+                             self->external_cancel_id);
+    self->external_cancel_id = 0;
+  }
+  g_clear_object(&self->external_cancellable);
+}
+
+static void complete_initialization(FlSettingsPortal* self) {
+  if (self->initialization == nullptr) {
+    return;
+  }
+  disconnect_initial_cancellable(self);
+  GTask* task = self->initialization;
+  self->initialization = nullptr;
+  if (!g_task_return_error_if_cancelled(task)) {
+    g_task_return_boolean(task, TRUE);
+  }
+  g_object_unref(task);
+}
+
+static void cancel_requests(FlSettingsPortal* self) {
+  ++self->generation;
+  for (auto& request : self->requests) {
+    request.pending = FALSE;
+    if (request.cancellable != nullptr) {
+      g_cancellable_cancel(request.cancellable);
+    }
+    if (request.cancel_id != 0) {
+      g_cancellable_disconnect(self->cancellable, request.cancel_id);
+      request.cancel_id = 0;
+    }
+    g_clear_object(&request.cancellable);
+  }
+  self->pending = 0;
+  g_clear_pointer(&self->staged, g_variant_dict_unref);
+}
+
+static void settle_request(FlSettingsPortal* self, guint index) {
+  if (self->retired || !self->requests[index].pending) {
+    return;
+  }
+  auto& request = self->requests[index];
+  request.pending = FALSE;
+  if (request.cancel_id != 0) {
+    g_cancellable_disconnect(self->cancellable, request.cancel_id);
+    request.cancel_id = 0;
+  }
+  g_clear_object(&request.cancellable);
+  if (--self->pending == 0) {
+    if (g_cancellable_is_cancelled(self->cancellable)) {
+      g_clear_pointer(&self->staged, g_variant_dict_unref);
+    } else {
+      commit_snapshot(self);
+    }
+    complete_initialization(self);
+  }
+}
