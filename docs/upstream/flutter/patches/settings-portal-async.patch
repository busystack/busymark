+  self->pending = G_N_ELEMENTS(kAllSettings);
+  for (guint i = 0; i < G_N_ELEMENTS(kAllSettings); ++i) {
+    auto& request = self->requests[i];
+    request.pending = TRUE;
+    request.cancellable = g_cancellable_new();
+    request.cancel_id = g_cancellable_connect(
+        self->cancellable, G_CALLBACK(+[](GCancellable*, gpointer data) {
