+static void schedule_publish(FlSettingsPortal* self) {
+  if (self->retired || self->publish_source != nullptr) {
+    return;
+  }
+  // At most one short dispatch. No strong reference: disposal destroys the
+  // source before releasing its provider. Hold a reference only while running,
+  // because a changed handler may dispose or release the provider reentrantly.
+  self->publish_source = g_idle_source_new();
+  g_source_set_priority(self->publish_source, G_PRIORITY_DEFAULT);
+  g_source_set_callback(
+      self->publish_source,
+      +[](gpointer data) -> gboolean {
+        g_autoptr(FlSettingsPortal) portal =
+            FL_SETTINGS_PORTAL(g_object_ref(data));
+        g_clear_pointer(&portal->publish_source, g_source_unref);
+        const auto next = snapshot(portal);
+        const auto previous = portal->published;
+        portal->published = next;
+        if (next.clock != previous.clock || next.color != previous.color ||
+            next.animations != previous.animations ||
+            next.contrast != previous.contrast ||
+            next.scale != previous.scale) {
+          fl_settings_emit_changed(FL_SETTINGS(portal));
+        }
+        return G_SOURCE_REMOVE;
+      },
+      self, nullptr);
+  g_source_attach(self->publish_source, self->context);
+}
