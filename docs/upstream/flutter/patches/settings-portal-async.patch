+  g_autoptr(GDBusConnection) connection = g_bus_get_finish(result, &error);
+  g_autoptr(FlSettingsPortal) self =
+      FL_SETTINGS_PORTAL(g_weak_ref_get(&callback->portal));
+  if (self == nullptr || self->retired) {
+    return;
+  }
+  if (g_cancellable_is_cancelled(self->cancellable)) {
+    complete_initialization(self);
+    return;
+  }
+  if (connection == nullptr) {
+    if (g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+      complete_initialization(self);
+    } else {
+      use_local_settings(self, error);
+    }
+    return;
+  }
+  const auto flags = static_cast<GDBusProxyFlags>(
