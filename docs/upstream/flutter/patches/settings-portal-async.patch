+static void read_settings(FlSettingsPortal* self) {
+  cancel_requests(self);
+  self->staged = g_variant_dict_new(nullptr);
+  for (const auto& setting : kAllSettings) {
+    g_autoptr(GVariant) value = nullptr;
+    if (get_value(self, &setting, &value)) {
+      g_autofree gchar* key = format_key(&setting);
+      g_variant_dict_insert_value(self->staged, key, value);
+    }
