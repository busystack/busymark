+static void owner_changed_cb(GDBusProxy* proxy,
+                             GParamSpec*,
+                             gpointer user_data) {
+  FlSettingsPortal* self = FL_SETTINGS_PORTAL(user_data);
+  if (self->retired || g_cancellable_is_cancelled(self->cancellable)) {
+    return;
+  }
+  g_autofree gchar* owner = g_dbus_proxy_get_name_owner(proxy);
+  if (g_strcmp0(owner, self->owner) == 0) {
+    return;
+  }
+  const gboolean first_activation =
+      self->owner == nullptr && !self->had_owner &&
+      self->initialization != nullptr && self->pending > 0;
+  g_free(self->owner);
+  self->owner = g_strdup(owner);
+  self->had_owner |= owner != nullptr;
+  if (first_activation && owner != nullptr) {
+    // The original calls activated this owner. Their responses are valid;
+    // issuing a second initial batch would duplicate all six requests.
+    return;
+  }
+  if (owner != nullptr) {
+    read_settings(self);
+  } else {
+    cancel_requests(self);
+    // Retain the last complete authority on owner loss. A replacement owner
+    // supplies a fresh coherent snapshot; canceled old replies cannot publish.
+    complete_initialization(self);
+  }
