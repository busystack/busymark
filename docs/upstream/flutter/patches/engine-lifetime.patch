+void fl_engine_shutdown_compositor(FlEngine* self, FlCompositor* compositor) {
+  g_assert(g_thread_self() == self->thread);
+  // Retire the renderer before calling this function. New presentations must
+  // return without waiting, otherwise a render-thread fence would deadlock.
+  struct Shutdown {
+    FlCompositor* compositor;
+    GMutex mutex;
+    GCond condition;
+    gboolean finished;
+  } shutdown = {compositor, {}, {}, FALSE};
+  g_mutex_init(&shutdown.mutex);
+  g_cond_init(&shutdown.condition);
+  gboolean posted = FALSE;
+  if (self->engine != nullptr) {
+    posted = self->embedder_api.PostRenderThreadTask != nullptr &&
+        self->embedder_api.PostRenderThreadTask(
+        self->engine,
+        [](void* data) {
+          auto* shutdown = static_cast<Shutdown*>(data);
+          fl_compositor_shutdown(shutdown->compositor);
+          g_mutex_lock(&shutdown->mutex);
+          shutdown->finished = TRUE;
+          g_cond_signal(&shutdown->condition);
+          g_mutex_unlock(&shutdown->mutex);
+        },
+        &shutdown) == kSuccess;
+    if (!posted) {
+      // A failed engine cannot accept a cleanup task. Join its raster work
+      // before moving that context to the GTK thread for final cleanup.
+      g_warning("Failed to post compositor shutdown; shutting down engine");
+      {
+        g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&self->renderables_mutex);
+        self->shutting_down = TRUE;
+      }
+      if (self->embedder_api.Shutdown(self->engine) != kSuccess) {
+        g_error("Unable to quiesce failed engine before compositor cleanup");
+      }
+      self->engine = nullptr;
+      release_completed_presentations(self);
+    }
+  }
+  if (posted) {
+    g_mutex_lock(&shutdown.mutex);
+    while (!shutdown.finished) {
+      g_cond_wait(&shutdown.condition, &shutdown.mutex);
+    }
+    g_mutex_unlock(&shutdown.mutex);
+  } else {
+    fl_compositor_shutdown(compositor);
+  }
+  g_cond_clear(&shutdown.condition);
+  g_mutex_clear(&shutdown.mutex);
+}
